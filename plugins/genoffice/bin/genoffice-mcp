#!/bin/sh
# Starts the GenOffice CLI's MCP server over HTTP for the plugin's sidecar.
# Arguments come from plugin.json: "mcp --http <port>". The token is read from GENOFFICE_MCP_TOKEN.
#
# The CLI ships with the GenOffice app. Found in this order:
#   $GENOFFICE_BIN, `genoffice` on the PATH, the Linux package (/opt/GenOffice),
#   the macOS app bundle.
set -eu

bin="${GENOFFICE_BIN:-}"
if [ -z "$bin" ]; then
  if command -v genoffice >/dev/null 2>&1; then
    bin="$(command -v genoffice)"
  elif [ -x /opt/GenOffice/resources/cli/genoffice ]; then
    bin=/opt/GenOffice/resources/cli/genoffice
  elif [ -x /Applications/GenOffice.app/Contents/Resources/cli/genoffice ]; then
    bin=/Applications/GenOffice.app/Contents/Resources/cli/genoffice
  fi
fi

if [ -z "$bin" ] || [ ! -x "$bin" ]; then
  echo "GenOffice CLI not found. Install the GenOffice app, or set GENOFFICE_BIN to its genoffice launcher." >&2
  exit 1
fi

exec "$bin" "$@"
